{
  "schema": "v4",
  "rules": [
    {
      "id": "high-default",
      "level": "high",
      "action": "block_remote",
      "match": {
        "type": "substring",
        "patterns": [
          "保密",
          "合同",
          "薪酬",
          "NDA",
          "股权",
          "商业秘密",
          "商业机密",
          "机密",
          "未公开",
          "严禁外传",
          "confidential",
          "contract",
          "薪资结构",
          "竞业协议",
          "专利草案",
          "融资计划",
          "收购",
          "内部审计",
          "核心算法",
          "客户名单",
          "财务报表",
          "法务意见",
          "尽调报告",
          "诉讼策略",
          "源码",
          "源代码",
          "数据库密码",
          "API密钥",
          "API Key",
          "access token",
          "私钥",
          "密码本",
          "密钥",
          "报价单",
          "供应商",
          "对外报价",
          "底价",
          "成本价",
          "合同金额",
          "应急预案"
        ]
      },
      "note": "通用强隐私词表：命中后禁一切远程访问。ASCII 词自动加词边界（防 veranda 命中 NDA）。发布版已泛化，不含带特定行业/渠道色彩的业务词。"
    },
    {
      "id": "medium-default",
      "level": "medium",
      "action": "prefer_local",
      "match": {
        "type": "substring",
        "patterns": [
          "员工",
          "预算",
          "税务",
          "股东",
          "合规",
          "用户隐私",
          "个人数据",
          "投融资",
          "内部文档",
          "项目计划",
          "审计",
          "尽调",
          "客户",
          "订单",
          "销售数据",
          "库存",
          "采购",
          "通讯录",
          "手机号",
          "身份证",
          "家庭住址",
          "会议纪要",
          "招标",
          "投标",
          "商务往来"
        ]
      },
      "note": "通用中等隐私信号：命中后仅本地执行，禁远程抓取。"
    }
  ],
  "exceptions": [
    {
      "id": "acquisition-in-public-news",
      "demote_to": "none",
      "applies_to": [
        {
          "rule": "high-default",
          "patterns": [
            "收购"
          ]
        }
      ],
      "when": {
        "type": "substring",
        "patterns": [
          "新闻",
          "公告",
          "公开报道",
          "行业动态",
          "快讯",
          "资讯",
          "报道"
        ]
      },
      "note": "公开新闻里的「收购」是误伤——这是 v5.1 诚实清单记录的第一条局限，v4 用模式级豁免正式修掉。注意只豁免「收购」这一个模式：同一条规则里的「保密」「股权」照常拦，所以「帮我写保密协议，顺便看看新闻」仍然是 high。"
    }
  ],
  "topic_shift_keywords": [
    "换个话题",
    "不谈这个了",
    "另外开一个",
    "新的话题",
    "不聊这个了",
    "下一个任务",
    "新任务",
    "说点别的",
    "换一个主题"
  ],
  "remote_tool_patterns": [
    "*web*",
    "*fetch*",
    "*browse*",
    "*search*",
    "*crawl*",
    "*http*"
  ]
}
